{
  "name": "subject-quest",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "repo:check": "python3 scripts/check-repo.py",
    "test:browser": "npm run build && node tests/browser.mjs",
    "test:themes": "npm run build && node tests/themes-browser.mjs",
    "bank:check": "node scripts/check-bank.js",
    "theme:create": "node scripts/create-theme.js",
    "test:theme-extension": "node tests/theme-extension-browser.mjs",
    "bank:import:ceval": "python3 scripts/import-ceval.py",
    "test:ceval": "npm run build && node tests/ceval-browser.mjs",
    "test:dungeon": "npm run build && node tests/dungeon-browser.mjs",
    "test:formula": "npm run build && node tests/formula-browser.mjs",
    "test:pal-media": "npm run build && node tests/pal-media-browser.mjs",
    "test:cards": "npm run build && node tests/combat-cards-browser.mjs",
    "test:learning": "npm run build && node tests/learning-browser.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "katex": "^0.18.7"
  }
}
